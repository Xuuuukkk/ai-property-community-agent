# =============================================================================
# AI Property Community Agent — PRODUCTION Environment Template
# =============================================================================
# Copy this file to `.env` on your production server and fill in REAL values.
# NEVER commit the filled-in `.env` — it contains secrets.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # database
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AI Property Community Agent
APP_ENV=production
API_PREFIX=/api
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------
# JWT signing key. MUST be a strong random value >=32 chars. The app refuses
# to boot in production with the insecure default, so leave a real value here.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# -----------------------------------------------------------------------------
# CORS & Frontend
# -----------------------------------------------------------------------------
# Comma-separated origins allowed to call the API. Use your real HTTPS domain.
BACKEND_CORS_ORIGINS=https://your-domain.com

# Public URL where the frontend is served.
FRONTEND_URL=https://your-domain.com

# Base URL for the backend API used by the frontend build.
VITE_API_BASE_URL=https://your-domain.com/api

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=property_agent
POSTGRES_USER=property_admin
POSTGRES_PASSWORD=

# SQLAlchemy URL. Replace the password with a strong random value.
DATABASE_URL=postgresql+psycopg2://property_admin:CHANGE_ME_STRONG_PASSWORD@postgres:5432/property_agent

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
# Redis with a password. Format: redis://:PASSWORD@host:port/db
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# -----------------------------------------------------------------------------
# AI / LLM (Zhipu OpenAI-compatible)
# -----------------------------------------------------------------------------
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=

# Chat model.
LLM_MODEL=glm-4-flash

# Embedding: "embedding-3" (1024-d, recommended) or "embedding-2".
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=1024

# Optional HuggingFace token (only needed for gated sentence-transformers).
HF_TOKEN=

# -----------------------------------------------------------------------------
# Deployment / Nginx / TLS
# -----------------------------------------------------------------------------
# Public domain for Nginx reverse proxy and SSL certificate.
DOMAIN=your-domain.com

# Email used for Let's Encrypt certificate registration.
SSL_EMAIL=admin@your-domain.com

# Ports exposed by the frontend Nginx gateway.
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
