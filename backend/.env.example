# Application
APP_NAME=AI Property Community Agent
APP_ENV=local
API_PREFIX=/api
SECRET_KEY=change-me-in-production-please-generate-a-32-byte-key

# Database (PostgreSQL 16 + pgvector). Use host=postgres inside docker compose,
# host=localhost when running the app directly on your machine.
DATABASE_URL=postgresql+psycopg2://admin:password@localhost:5432/property_agent

# Cache
REDIS_URL=redis://localhost:6379/0

# AI (Phase 5/6)
# 默认使用智谱 (Zhipu) OpenAI-compatible API；如需 OpenAI 请改 OPENAI_API_BASE。
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4-flash
# embedding-3 / embedding-2 为智谱 embedding；deterministic 为离线测试用。
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSION=1024
