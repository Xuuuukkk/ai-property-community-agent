# AI Property Community Agent — Environment Configuration Template
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and should never be committed.

# =============================================================================
# Application
# =============================================================================
APP_NAME=AI Property Community Agent
APP_ENV=production
API_PREFIX=/api
LOG_LEVEL=INFO

# Used for signed tokens / session cookies when authentication is enabled.
# Generate a strong random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-please-generate-a-32-byte-key

# Comma-separated list of frontend origins allowed to call the backend API.
# Include localhost:5173 for Vite dev server and localhost:3000 for Docker/Nginx.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Database (PostgreSQL 16 + pgvector)
# =============================================================================
# For Docker Compose the host is the service name `postgres`.
# For local development outside Docker use `localhost`.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=property_agent
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-in-production

# SQLAlchemy connection URL used by the backend.
DATABASE_URL=postgresql+psycopg2://admin:change-me-in-production@postgres:5432/property_agent

# =============================================================================
# Cache (Redis)
# =============================================================================
# For Docker Compose the host is the service name `redis`.
REDIS_URL=redis://redis:6379/0

# =============================================================================
# AI / LLM (optional until real LLM is wired in)
# =============================================================================
# OpenAI-compatible API base URL and key.
OPENAI_API_BASE=https://api.openai.com/v1
LLM_API_KEY=

# Chat model name. Must be supported by the provider above.
# Examples: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, qwen-plus, deepseek-chat.
LLM_MODEL=gpt-4o-mini

# Embedding model. Leave empty to use sentence-transformers/all-MiniLM-L6-v2.
# Use "deterministic" for local development / tests without downloading models.
EMBEDDING_MODEL=deterministic

# Optional HuggingFace token, required for some gated embedding models.
HF_TOKEN=

# =============================================================================
# Frontend
# =============================================================================
# Public URL where the frontend is served; used by CORS and any absolute links.
FRONTEND_URL=https://your-domain.com

# Base URL for the backend API (used by the frontend build / runtime requests).
VITE_API_BASE_URL=https://your-domain.com/api

# =============================================================================
# Deployment / Nginx
# =============================================================================
# Public domain for the Nginx reverse proxy and SSL certificate.
DOMAIN=your-domain.com

# Email used for Let's Encrypt certificate registration.
SSL_EMAIL=admin@your-domain.com
